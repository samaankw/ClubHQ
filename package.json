{
  "name": "clubhq",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:functions": "deno test --quiet --no-check=remote supabase/functions/tests/",
    "doctor": "expo-doctor",
    "prebuild:clean": "expo prebuild --clean",
    "verify": "npm run verify:static && npm run lint:tokens && npm run typecheck && npm run lint && npm test -- --ci && npx expo-doctor@latest",
    "verify:static": "node scripts/project-check.mjs",
    "lint": "eslint .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rls": "npx supabase@latest test db",
    "gen:types": "supabase gen types typescript --linked > types/database.types.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.57.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.17",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-speech-recognition": "^56.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "^57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
